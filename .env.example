# BotFather → /newbot → токен (формат 123456:AAH...)
BOT_TOKEN=

# Ваш Telegram user_id (узнать у @userinfobot). Через запятую можно несколько.
ADMIN_IDS=

# Куда слать уведомления о заявках (личка = тот же ID что в ADMIN_IDS, группа = -100...)
ADMIN_CHAT_ID=

# По умолчанию SQLite. Для Postgres: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Опциональный HTTP/SOCKS proxy для исходящих запросов к Telegram API.
# Нужен если хост блокирует api.telegram.org напрямую (РФ и др.).
# Пример (xray/v2ray на хосте): http://127.0.0.1:10808
# Требует network_mode: host в docker-compose.yml для доступа к localhost хоста.
# BOT_PROXY=

