# BotFather → /newbot → токен (формат 123456:AAH...)
BOT_TOKEN=

# Ваш Telegram user_id (узнать у @userinfobot). Через запятую можно несколько.
ADMIN_IDS=

# Куда слать уведомления о заявках (личка = тот же ID что в ADMIN_IDS, группа = -100...)
ADMIN_CHAT_ID=

# По умолчанию SQLite. Для Postgres: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
